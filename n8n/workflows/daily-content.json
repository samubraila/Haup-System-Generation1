{
  "name": "AI Content Factory - Taeglicher Lauf",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Taeglich 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-360, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.ACF_BACKEND_URL }}/api/automation/ideas?status=approved&limit=3",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ACF_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Freigegebene Ideen holen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Ideen aufteilen",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [80, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACF_BACKEND_URL }}/api/automation/videos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ACF_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ projectId: $json.project_id, ideaId: $json.id, title: $json.title, topic: $json.topic, description: $json.description, startNow: true }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Video anlegen und generieren",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 0]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "minutes"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Warten",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [520, 0],
      "webhookId": "a1000000-0000-4000-8000-0000000000f1"
    },
    {
      "parameters": {
        "url": "={{ $env.ACF_BACKEND_URL }}/api/automation/videos/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ACF_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Status pruefen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 0]
    }
  ],
  "connections": {
    "Taeglich 09:00": {
      "main": [[{ "node": "Freigegebene Ideen holen", "type": "main", "index": 0 }]]
    },
    "Freigegebene Ideen holen": {
      "main": [[{ "node": "Ideen aufteilen", "type": "main", "index": 0 }]]
    },
    "Ideen aufteilen": {
      "main": [[{ "node": "Video anlegen und generieren", "type": "main", "index": 0 }]]
    },
    "Video anlegen und generieren": {
      "main": [[{ "node": "Warten", "type": "main", "index": 0 }]]
    },
    "Warten": {
      "main": [[{ "node": "Status pruefen", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}

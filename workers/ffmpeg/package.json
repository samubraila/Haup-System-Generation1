{
  "name": "@acf/worker-ffmpeg",
  "version": "1.0.0",
  "private": true,
  "description": "FFmpeg-Worker: Schnitt, Skalierung, Audio, Untertitel-Einbrennen",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",

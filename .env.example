# =============================================================================
#  AI CONTENT STUDIO - Environment Configuration
# =============================================================================
#  Kopiere diese Datei nach `.env` und passe die Werte an:
#      Windows PowerShell:  Copy-Item .env.example .env
#      Git Bash / Linux:    cp .env.example .env
#
#  WICHTIG: `.env` wird NIE committed (steht in .gitignore).
#  Alle Secrets automatisch erzeugen:  node scripts/generate-secrets.mjs
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Allgemein
# -----------------------------------------------------------------------------
NODE_ENV=production
TZ=Europe/Berlin
# Basis-URL unter der das Frontend erreichbar ist (wichtig fuer OAuth-Redirects)
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# 2. Ports (Host-seitig)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_PORT=5678
VIDEO_GENERATOR_PORT=8000

# -----------------------------------------------------------------------------
# 3. PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=aistudio
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=aistudio
DATABASE_URL=postgresql://aistudio:CHANGE_ME_postgres_password@postgres:5432/aistudio

# -----------------------------------------------------------------------------
# 4. Redis (Queue / Jobs)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379

# -----------------------------------------------------------------------------
# 5. Security  --  ALLE WERTE ZWINGEND AENDERN
# -----------------------------------------------------------------------------
# JWT Signatur-Key (min. 32 Zeichen). Erzeugen: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_string_for_jwt_signing_secret_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# AES-256-GCM Master Key fuer die Verschluesselung der OAuth-Tokens in der DB.
# MUSS exakt 64 Hex-Zeichen sein (= 32 Byte). Erzeugen: openssl rand -hex 32
# ACHTUNG: Wird dieser Key geaendert, sind alle gespeicherten Social-Tokens unlesbar.
ENCRYPTION_KEY=CHANGE_ME_exactly_64_hex_chars_0000000000000000000000000000000000

# Session-Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# CORS (Komma-getrennte Liste erlaubter Origins)
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# 6. Erster Admin-Benutzer (wird beim ersten Start automatisch angelegt)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=CHANGE_ME_admin_password_min_12_chars
ADMIN_NAME=Administrator

# -----------------------------------------------------------------------------
# 7. Storage
# -----------------------------------------------------------------------------
# Pfad INNERHALB der Container. Das Host-Mapping steuert STORAGE_HOST_PATH.
DATA_DIR=/data
STORAGE_HOST_PATH=./data
MAX_UPLOAD_MB=512
ALLOWED_UPLOAD_MIME=image/png,image/jpeg,image/webp,audio/mpeg,audio/wav,audio/mp4,video/mp4,video/quicktime,video/webm,text/plain,application/x-subrip

# -----------------------------------------------------------------------------
# 8. Lokale Video-KI (video-generator Service)
# -----------------------------------------------------------------------------
VIDEO_GENERATOR_URL=http://video-generator:8000
# Aktiver Adapter: stock | slideshow | ltx | wan | comfyui | placeholder
#   stock       echtes Filmmaterial von Pexels/Pixabay, keine GPU noetig  (empfohlen)
#   slideshow   eigene Bilder mit Kamerafahrt, keine GPU noetig
#   ltx | wan   echte KI-Videogenerierung, braucht NVIDIA-GPU
#   comfyui     eigener ComfyUI-Workflow auf dem Host
#   placeholder erzeugt KEIN Video, nur einen technischen Testclip
VIDEO_GENERATOR_PROVIDER=placeholder
VIDEO_GENERATOR_TIMEOUT_MS=3600000

# --- GPU ---
# auto  = GPU verwenden wenn vorhanden, sonst Job auf WAITING_FOR_GPU setzen
# force = GPU zwingend erforderlich (Jobs warten ohne GPU)
# off   = nur CPU-faehige Adapter zulassen
GPU_MODE=auto
# Minimaler freier VRAM (MB) damit ein Generierungsjob startet
GPU_MIN_VRAM_MB=8000
NVIDIA_VISIBLE_DEVICES=all

# --- Stock-Material (kostenlos, keine KI-Kosten) ---
# Beide Schluessel sind kostenlos und ohne Zahlungsdaten erhaeltlich:
#   Pexels:  https://www.pexels.com/api/         (Videos und Fotos)
#   Pixabay: https://pixabay.com/api/docs/       (Videos und Fotos)
# Es genuegt einer von beiden. Anleitung: docs/STOCK_FOOTAGE.md
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Modellpfade (im video-generator Container) ---
MODELS_DIR=/models
LTX_MODEL_PATH=/models/ltx-video
WAN_MODEL_PATH=/models/wan
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_WORKFLOW=default_t2v.json

# -----------------------------------------------------------------------------
# 9. Speech-to-Text (Untertitel) und TTS (Voice)
# -----------------------------------------------------------------------------
# faster-whisper Modell: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Piper TTS (optional, Modell muss separat nach /models/piper gelegt werden)
TTS_PROVIDER=none
PIPER_MODEL_PATH=/models/piper/de_DE-thorsten-medium.onnx

# -----------------------------------------------------------------------------
# 10. Worker / Queue
# -----------------------------------------------------------------------------
GENERATION_CONCURRENCY=1
MEDIA_CONCURRENCY=2
PUBLISH_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
GPU_RECHECK_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# 11. Human Approval
# -----------------------------------------------------------------------------
# true = Videos muessen manuell freigegeben werden bevor sie veroeffentlicht werden
REQUIRE_APPROVAL_DEFAULT=true

# -----------------------------------------------------------------------------
# 12. n8n Automatisierung
# -----------------------------------------------------------------------------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key_32_chars_min
# API-Key den n8n verwendet um das Backend anzusprechen (Header: X-API-Key)
INTERNAL_API_KEY=CHANGE_ME_internal_api_key_for_n8n_and_services

# -----------------------------------------------------------------------------
# 13. Social Media - OAuth Zugangsdaten
# -----------------------------------------------------------------------------
# Diese Werte stammen aus den jeweiligen Developer-Portalen.
# Solange sie leer sind, zeigt die Oberflaeche "Not configured" an.
# Schritt-fuer-Schritt Anleitung: docs/SOCIAL_SETUP.md
#
# --- YouTube (Google Cloud Console -> YouTube Data API v3) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/social/youtube/callback

# --- TikTok (TikTok for Developers -> Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/social/tiktok/callback

# --- Instagram (Meta for Developers -> Instagram Graph API) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/social/instagram/callback

# --- Facebook (Meta for Developers -> Facebook Login + Pages API) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/social/facebook/callback

# -----------------------------------------------------------------------------
# 14. Analytics Sync
# -----------------------------------------------------------------------------
ANALYTICS_SYNC_ENABLED=true
ANALYTICS_SYNC_INTERVAL_MIN=360

# -----------------------------------------------------------------------------
# 15. Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_TO_DB=true
LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 16. Backup
# -----------------------------------------------------------------------------
BACKUP_DIR=/backups
BACKUP_INCLUDE_MEDIA=false
BACKUP_RETENTION=7
